# ====================================================================
# Smart Expense Analyzer — Backend Environment Configuration
# ====================================================================

# 1. OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Recommended OpenRouter models (pricing and speed vary):
# - meta-llama/llama-3.3-70b-instruct (Fast, high-quality reasoning)
# - anthropic/claude-3.5-haiku (Extremely fast, structured output)
# - google/gemini-2.0-flash-001 (Very fast, economical)
# - openai/gpt-4o-mini (Reliable, cost-effective)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 2. Supabase Database Configuration
# Obtain your project URL and keys from:
# Supabase Dashboard -> Your Project -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use your Service Role Secret Key (server-side only) or Anon Key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Application Options
# Set to 'true' to disable automatic initial sample data insertion
DISABLE_SAMPLE_DATA=false
